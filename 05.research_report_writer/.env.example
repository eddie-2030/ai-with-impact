# Use a dedicated local PostgreSQL database. Substitute your development credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/research_writer

# Fixture mode makes no search or model requests. Choose tavily for live research.
RESEARCH_SEARCH_MODE=fixture
TAVILY_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
